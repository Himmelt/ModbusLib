<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>Himmelt.ModbusLib</PackageId>
    <Version>1.0.7</Version>
    <Authors>Himmelt</Authors>
    <Company>Himmelt</Company>
    <Description>一个功能完整、高性能的Modbus客户端库，支持.NET 8/9/10平台和多种Modbus协议变体。</Description>
    <Copyright>Copyright © 2024-2026 Himmelt</Copyright>
    <PackageProjectUrl>https://github.com/Himmelt/ModbusLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Himmelt/ModbusLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Tags>modbus, modbus-rtu, modbus-tcp, modbus-udp, .net, dotnet, client, protocol</Tags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>ModbusLib</Title>
    <PackageTags>modbus;modbus-rtu;modbus-tcp;modbus-udp;.net;dotnet;client;protocol</PackageTags>
    <PackageReleaseNotes>v1.0.7: 传输层引入 LinkState 分层故障模型，把「请求超时」与「链路断开」彻底拆开。背景：一条 Modbus 连接挂多个从站是标准形态，而原实现一发超时就 DisconnectInternal()，共享连接会因某个从站不应答导致全体设备停摆，Retries>0 的重试路径还会再断一次。行为变更（BREAKING）：① TcpTransport 请求超时不再关闭 socket，改为排空接收缓冲后抛 ModbusTimeoutException，连接保留；仅收到 FIN / RST / IO 异常才关闭连接并标记 IsLinkBroken；② ModbusClientBase 移除请求路径内的隐式重连（Rebuild/TryReconnect 与私有连接意图标志一并删除），重连职责交给调用方；Retries>0 现在只在 LinkState==Up 且异常非链路级时在同一条链路上重发；③ RTU 传输（TCP/串口）新增响应身份校验，丢弃不是本次请求的帧后继续等待——这是「不拆连接」的安全前提。新增 API：LinkState 枚举与 LinkStateChanged 事件（IModbusTransport/IModbusClient，ModbusClientBase 直接转发）；NetworkConfig.LockTimeout（等锁与收发预算分开，必须先拿锁再启动事务超时，否则会被 Timeout 先掐掉）；NetworkConfig.KeepAliveEnabled/TimeSeconds/IntervalSeconds/RetryCount（默认 30s/5s/3，覆盖 OS 默认 2 小时静默，用于发现不产生任何错误信号的半开连接）；异常的 IsLinkBroken 与 IsLockWaitTimeout 标记，由抛出点标记，调用方无需再匹配 message 字符串。UdpTransport/SerialTransport 补齐 LinkState（串口另补 RTU 身份校验）；Channel/Pipe 无物理链路，恒为 Up。升级注意：原先依赖库自动重连的调用方，需自行实现连接看护者（订阅 LinkStateChanged 或轮询 LinkState 后调 ConnectAsync）。v1.0.6: 修复 TCP/UDP/串口客户端断线（网线松动、设备重启、USB 拔插）后无法自愈——原「未连接」检查位于重试循环之外，一旦进入未连接态，后续每个请求都会立即抛 ModbusConnectionException 且 Retries 完全失效（重试与重连都不会执行），对端恢复后永久失联；现在未连接按可重试的连接故障处理，在 Retries &gt;= 1 且调用方调用过 Connect/ConnectAsync 时，下一轮请求会自动重建会话并成功（重建不构成「重发」，对写操作无额外风险）。新增私有连接意图标志：ConnectAsync 置位、DisconnectAsync 复位，使显式停机不被自动重连顶回来。行为变更（仅 Retries &gt;= 1 生效）：Retries = 0（默认）行为与 1.0.5 完全一致；调用方从未调用 Connect/ConnectAsync 时仍抛「客户端未连接」，不擅自建连；零新增公开 API。注意：拔网线/设备掉电时 TCP 不发 FIN、IsConnected 仍为 true，自愈的触发点是「读超时 → 传输层断开 → 下一轮重建」，请显式配置 Timeout 与 NetworkConfig.ReceiveTimeout，否则默认 -1 会让请求无限阻塞，任何自动重连都不会被触发。</PackageReleaseNotes>
    <PackageIcon>nuget_logo.png</PackageIcon>
  </PropertyGroup>

  <!-- 包含README.md文件到NuGet包 -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nuget_logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
