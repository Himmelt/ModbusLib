<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AnalysisLevel>latest-all</AnalysisLevel>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>Himmelt.ModbusLib</PackageId>
    <Version>1.0.4</Version>
    <Authors>Himmelt</Authors>
    <Company>Himmelt</Company>
    <Description>一个功能完整、高性能的Modbus客户端库，支持.NET 8/9/10平台和多种Modbus协议变体。</Description>
    <Copyright>Copyright © 2024-2026 Himmelt</Copyright>
    <PackageProjectUrl>https://github.com/Himmelt/ModbusLib</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Himmelt/ModbusLib</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Tags>modbus, modbus-rtu, modbus-tcp, modbus-udp, .net, dotnet, client, protocol</Tags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Title>ModbusLib</Title>
    <PackageTags>modbus;modbus-rtu;modbus-tcp;modbus-udp;.net;dotnet;client;protocol</PackageTags>
    <PackageReleaseNotes>v1.0.4: 全面修复传输层超时/断线/帧解析缺陷，TCP 按 MBAP/RTU 精确成帧、超时后自动清理连接、重试前自动重连；UDP 支持域名；串口异步 I/O 可取消；协议层增加事务ID校验与畸形帧防护；修复 byte 泛型读写与奇数字节校验。</PackageReleaseNotes>
    <PackageIcon>nuget_logo.png</PackageIcon>
  </PropertyGroup>

  <!-- 包含README.md文件到NuGet包 -->
  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <GenerateAssemblyInfo>True</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**" />
    <EmbeddedResource Remove="obj\**" />
    <None Remove="obj\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nuget_logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
